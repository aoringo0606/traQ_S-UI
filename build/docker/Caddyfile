{
    admin off
}

:80

encode zstd gzip
header /sw.js Cache-Control "max-age=0"

handle /api/* {
    reverse_proxy {$TRAQ_ORIGIN:https://q-dev.trapti.tech} {
        header_up Host {upstream_hostport}
    }
}

handle /.well-known/* {
    reverse_proxy {$TRAQ_ORIGIN:https://q-dev.trapti.tech} {
        header_up Host {upstream_hostport}
    }
}

handle {
    root * /usr/share/caddy
    try_files {path} /index.html

    file_server {
        precompressed br gzip
    }
}
